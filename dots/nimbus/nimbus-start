#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

# Aplica el layout flotante antes de que entre el shell.
hyprctl keyword layout floating >/dev/null 2>&1 || true

# Fondo de Nimbus: swaybg pinta el arte propio de la sesion. Si falta el
# binario o el fichero, la sesion sigue igual: el shell pinta su base con
# la paleta de Nimbus y Hyprland no muestra su marca (misc en hyprland.lua).
NIMBUS_WALLPAPER="/usr/share/nimbus/backgrounds/Nimbus.png"
if command -v swaybg >/dev/null 2>&1 && [ -f "$NIMBUS_WALLPAPER" ]; then
    swaybg -i "$NIMBUS_WALLPAPER" -m fill >/dev/null 2>&1 &
    echo "nimbus-start: fondo $NIMBUS_WALLPAPER con swaybg (PID $!)" >&2
fi

# Si el shell no esta instalado, cae a un terminal de emergencia para que el
# usuario pueda diagnosticar en vez de quedarse con una sesion muda.
if [ ! -x /usr/bin/nimbus-shell ]; then
    echo "nimbus-start: /usr/bin/nimbus-shell no encontrado, lanzo terminal de emergencia" >&2
    kitty --class emergency &
    echo "nimbus-start: terminal de emergencia con PID $!" >&2
    exit 1
fi

# Sin exec: el proceso que Hyprland lanzo sigue supervisando; el shell va en
# segundo plano y queda su PID registrado.
# La sesion live de la ISO no muestra el tour: es efimera y se repetiria en
# cada arranque. En un sistema instalado, el tour si se muestra (como el
# primer arranque de un Mac). El flag lo decide la sesion live (NIMBUS_LIVE).
NIMBUS_SHELL_ARGS=()
if [ "${NIMBUS_LIVE:-0}" = "1" ]; then
    NIMBUS_SHELL_ARGS+=(--no-tour)
fi
/usr/bin/nimbus-shell "${NIMBUS_SHELL_ARGS[@]}" &
echo "nimbus-start: shell lanzado con PID $!"
wait "$!"
