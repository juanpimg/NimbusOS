    function lookup(locale, key) {
        var lang = String(locale || "en").split("-")[0]
        if (table[lang] && table[lang][key] !== undefined)
            return table[lang][key]
        if (table["en"] && table["en"][key] !== undefined)
            return table["en"][key]
        return key
    }
}
