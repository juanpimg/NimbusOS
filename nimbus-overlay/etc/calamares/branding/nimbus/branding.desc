---
# NimbusOS Calamares branding — adaptado del ejemplo fancy/
# (base: CachyOS/cachyos-calamares, GPL-3.0). Estilo Setup Assistant.
componentName: nimbus

welcomeStyleCalamares: false
welcomeExpandingLogo: true

# Tamano de ventana estilo asistente (1024x640).
windowSize: 1024,640

strings:
  productName: NimbusOS
  version: "1.0"
  shortVersion: "1.0"
  shortProductName: NimbusOS
  bootloaderEntryName: NimbusOS
  productUrl: https://nimbusos.example/
  supportUrl: https://nimbusos.example/support
  knownIssuesUrl: https://nimbusos.example/issues
  releaseNotesUrl: https://nimbusos.example/release-notes

images:
  productLogo: "nimbus-logo.png"
  productIcon: "nimbus-logo.png"
  productWelcome: "productWelcome.png"

slideshow: "show.qml"

# API 2 = componente Presentation/Slide de calamares.slideshow.
slideshowAPI: 2

style:
  sidebarBackground: "#F5F5F7"
  sidebarText: "#1D1D1F"
  sidebarTextSelect: "#007AFF"
  sidebarTextHighlight: "#007AFF"
