---
# NimbusOS Calamares branding — adaptado del ejemplo fancy/
# (base: CachyOS/cachyos-calamares, GPL-3.0). Estilo Setup Assistant.
componentName: nimbus

welcomeStyleCalamares: false
welcomeExpandingLogo: true

# Barra lateral explicita estilo asistente (brief: sidebar widget|none).
sidebar: widget
navigation: widget

# Tamano de ventana estilo asistente (1024x640).
windowSize: 1024,640

strings:
  productName: NimbusOS
  version: "1.0"
  shortVersion: "1.0"
  shortProductName: NimbusOS
  bootloaderEntryName: NimbusOS
  # P1 (2026-10-27): URLs de ejemplo eliminadas (nimbusos.example/ no existe;
  # el proyecto aun no publica web/soporte; Calamares no exige estos campos).

# Placeholders SVG minimos incluidos en este directorio (Task 5: arte final).
images:
  productLogo: "nimbus-logo.svg"
  productIcon: "nimbus-logo.svg"
  productWelcome: "productWelcome.svg"

slideshow: "show.qml"

# API 2 = componente Presentation/Slide de calamares.slideshow.
slideshowAPI: 2

style:
  sidebarBackground: "#F5F5F7"
  sidebarText: "#1D1D1F"
  sidebarTextSelect: "#007AFF"
  sidebarTextHighlight: "#007AFF"
