# kwinrulesrc — reglas de ventana Nimbus (KWin 6.8, verificado).
# Formato real (upstream kwin/rules.cpp + rulesettings.kcfg): [General]
# count=N + rules=lista; por regla [N]: Description (D mayúscula),
# wmclass+wmclassmatch (0=ignorar,1=exacta,2=subcadena,3=regex),
# wmclasscomplete=false (solo resourceClass), types (bitmask 1<<WindowType:
# Normal=1, Dialog=32, Utility=256), placement=Centered (PlacementPolicy=5)
# +placementrule=2 (Force, solo aplica al mapear), size=W,H +sizerule=3
# (Apply inicial: el usuario puede redimensionar), maximize*=false +rule=3
# (abre sin maximizar; maximizar manual sigue funcionando, NO Force).
# NO se tocan: position (centra placement), fullscreen (apps que lo piden lo
# conservan), ignoregeometry (respeta sesión), fsplevel/acceptfocus
# (defaults), decorationpolicy (CSD GTK3/4 y Electron intactas: F10-T06 —
# KWin decora solo SSD/XWayland legacy que la pide; Firefox CSD conserva sus
# botones a la derecha, excepción a semáforos XIA). Bar/Dock/
# Spotlight son layer-shell (no Normal): ninguna regla les aplica.

[General]
count=5
rules=1,2,3,4,5

