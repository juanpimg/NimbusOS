#!/bin/sh
# NimbusOS — wrapper /usr/bin/macshell
# Integración Quickshell/MacShell: prefiere el arranque por-usuario instalado
# por `install.sh` de MacShell (~/.local/bin/macshell-start: espera al
# compositor, evita segunda copia y reinicia el shell si hace crash).
# Fallback: lanzamiento directo con quickshell (p. ej. primera sesión live).
# Upstream: https://github.com/0-ss/MacShell (main @ 2026-10-23, MIT)
if [ -x "$HOME/.local/bin/macshell-start" ]; then
    exec sh "$HOME/.local/bin/macshell-start" "$@"
else
    command -v qs >/dev/null 2>&1 || { echo "macshell: falta quickshell (qs no encontrado)" >&2; exit 127; }
    exec qs -c MacShell "$@"
fi
