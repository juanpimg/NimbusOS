#!/bin/sh
# NimbusOS — nimbus-minimize-toggle (Task ventanas-p0, 2026-10-26)
# Toggle inteligente del shelf de minimizadas (SUPER+M en 10-shortcuts.conf
# y hyprland.lua). El boton amarillo de hyprbars manda a special:minimized
# pero nada restauraba: este script es la via de retorno por teclado
# (el click en el Dock enfoca y abre el shelf con la ventana activa).
#   * si la ventana ACTIVA vive en special:minimized -> la devuelve al
#     workspace visible bajo el shelf (activeworkspace sigue siendo el
#     workspace de fondo aunque el shelf este abierto; el compositor
#     auto-oculta el shelf al vaciarse);
#   * si no -> abre/cierra el shelf (togglespecialworkspace minimized).
# DOS FORMAS de dispatch (Hyprland 0.56 acepta una u otra segun la sesion):
#   * sesion Lua (existe ~/.config/hypr/hyprland.lua, tiene precedencia):
#     `hyprctl dispatch 'hl.dsp...'` (el dispatch CLI evalua Lua);
#   * sesion .conf legacy: dispatch clasico `dispatcher args`
#     (`hyprctl eval` aqui responde "only supported with lua config manager").
# Solo necesita hyprctl + python3 (falla en silencio sin ellos).
set -u
if command -v python3 >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1; then
    if [ -f "${HOME:-/root}/.config/hypr/hyprland.lua" ]; then
        TOGGLE="dispatch hl.dsp.workspace.toggle_special(\"minimized\")"
        move_back() { hyprctl dispatch "hl.dsp.window.move({ workspace = \"$1\" })" >/dev/null 2>&1; }
    else
        TOGGLE="dispatch togglespecialworkspace minimized"
        move_back() { hyprctl dispatch movetoworkspace "$1" >/dev/null 2>&1; }
    fi
    # shellcheck disable=SC2086
    active_ws="$(hyprctl activewindow -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("workspace",{}).get("name",""))' 2>/dev/null)"
    if [ "$active_ws" = "special:minimized" ]; then
        # Devolver al workspace visible bajo el shelf. NOTA: Hyprland
        # auto-oculta el shelf al quedarse vacio (verificado en 0.56.2):
        # NO hacer toggle de cierre aqui (lo re-abriria vacio).
        cur="$(hyprctl activeworkspace -j 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("id",1))' 2>/dev/null)"
        move_back "$cur"
        exit 0
    fi
    # shellcheck disable=SC2086
    hyprctl $TOGGLE >/dev/null 2>&1
fi
