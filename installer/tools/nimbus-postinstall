def step_power(ctx):
    """Perfil de energia y limite de carga si el hardware lo soporta."""
    name, lang = "power", ctx.locale
    try:
        path = str(pathlib.Path(str(ctx.root)) / "etc" / "nimbus"
                    / "power.conf")
        ctx.ex.write_text(
            path, f"[power]\nprofile={POWER_PROFILE}\n")
        detail = translated("postinstall.power.done", lang).format(
            profile=POWER_PROFILE)
        try:
            ctx.ex.set_charge_limit(CHARGE_LIMIT)
        except Exception:
            # Sin soporte no se finge: se dice con claridad.
            detail += " " + translated(
                "postinstall.power.no_battery", lang)
        return "ok", detail
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_hybrid(ctx):
    """Hibridos en on-demand si hay dGPU NVIDIA (opcional)."""
    name, lang = "hybrid", ctx.locale
    try:
        if not ctx.ex.has_nvidia_dgpu():
            return ("skipped",
                    translated("postinstall.hybrid.no_dgpu", lang))
        path = str(pathlib.Path(str(ctx.root)) / "etc" / "nimbus"
                    / "hybrid.conf")
        ctx.ex.write_text(path, render_hybrid_conf())
        return "ok", translated("postinstall.hybrid.done", lang)
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_skel(ctx):
