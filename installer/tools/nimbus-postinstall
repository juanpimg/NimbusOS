class Ctx:
    """Contexto de ejecucion: raiz destino, flags y ejecutor inyectable."""

    def __init__(self, root="/", offline=False, locale=None, ex=None):
        self.root = root
        self.offline = offline
        self.locale = locale if locale is not None else active_locale()
        self.ex = ex if ex is not None else Executor(str(root))


class Executor:
    """Efectos de sistema reales. Los tests lo sustituyen entero."""

    def __init__(self, root="/"):
        self.root = str(root)

    def _under_root(self, *parts):
        return str(pathlib.Path(self.root, *parts))

    def run(self, cmd):
        """Ejecuta un comando como lista, nunca con shell."""
        return subprocess.run(cmd, check=False, capture_output=True,
                              text=True, timeout=120)

    def read_text(self, path, default=None):
        try:
            return pathlib.Path(path).read_text(encoding="utf-8")
        except FileNotFoundError:
            if default is not None:
                return default
            raise

    def write_text(self, path, content):
        target = pathlib.Path(path)
        target.parent.mkdir(parents=True, exist_ok=True)
        if isinstance(content, bytes):
            target.write_bytes(content)
        else:
            target.write_text(content, encoding="utf-8")

    def cpuinfo_text(self):
        # La CPU destino es la del propio equipo que instala.
        return pathlib.Path("/proc/cpuinfo").read_text(encoding="utf-8")

    def has_nvidia_dgpu(self):
        try:
            result = subprocess.run(
                ["lspci", "-n"], check=False, capture_output=True,
                text=True, timeout=30)
        except (FileNotFoundError, subprocess.SubprocessError):
            return False
        vendors = set()
        nvidia_display = False
        for line in result.stdout.splitlines():
            if "10de" not in line:
                continue
            vendors.add(line.split()[0].rsplit(":", 1)[0])
            if "0300" in line or "0302" in line:
                nvidia_display = True
        return nvidia_display and len(vendors) >= 1 and _has_other_gpu(
            result.stdout)

    def battery_limit_supported(self):
        base = pathlib.Path("/sys/class/power_supply")
        if not base.is_dir():
            return False
        for entry in sorted(base.glob("BAT*")):
            if (entry / "charge_control_end_threshold").is_file():
                return True
        return False

    def set_charge_limit(self, percent):
        base = pathlib.Path("/sys/class/power_supply")
        for entry in sorted(base.glob("BAT*")):
            knob = entry / "charge_control_end_threshold"
            if knob.is_file():
                knob.write_text(str(percent), encoding="utf-8")
                return
        raise RuntimeError("no charge_control_end_threshold found")

    def keyring_source_files(self):
        """Pares (nombre, contenido) del keyring a copiar al destino."""
        sources = [
            pathlib.Path("/usr/share/pacman/keyrings"),
            pathlib.Path(__file__).resolve().parents[2]
            / "keyrings" / "nimbus",
        ]
        for directory in sources:
            names = ["nimbus.gpg", "nimbus-trusted", "nimbus-revoked"]
            files = [directory / name for name in names]
            if all(path.is_file() for path in files):
                return [(path.name, path.read_bytes()) for path in files]
        raise RuntimeError("nimbus keyring source not found")

    def dots_files(self):
        """Pares (relativo, contenido) de defaults a heredar en skel."""
        candidates = [
            pathlib.Path(__file__).resolve().parents[2] / "dots",
            pathlib.Path("/usr/share/nimbus/dots"),
        ]
        for base in candidates:
            if base.is_dir():
                found = []
                for path in sorted(base.rglob("*")):
                    if path.is_file():
                        found.append((str(path.relative_to(base)),
                                      path.read_bytes()))
                if found:
                    return found
        return []

    def enable_service(self, name):
        return subprocess.run(
            ["systemctl", "--root", self.root, "enable", name],
            check=False, capture_output=True, text=True, timeout=60)


def _has_other_gpu(lspci_output):
    """True si hay otra GPU ademas de la NVIDIA (hibrido real)."""
    display_lines = [line for line in lspci_output.splitlines()
                     if "0300" in line or "0302" in line]
    non_nvidia = [line for line in display_lines if "10de" not in line]
    return bool(non_nvidia)


def _title(name, locale):
    return translated(f"postinstall.step.{name}", locale)


def _hint(name, locale):
    return translated(f"postinstall.hint.{name}", locale)


def _failed(name, detail, locale):
    return translated("postinstall.step.failed", locale).format(
        step=_title(name, locale), detail=detail, hint=_hint(name, locale))


def cpu_supports_avx2(cpuinfo_text):
    """True si la CPU anuncia AVX2 (x86-64-v3).

    La ISO en vivo usa siempre el repo generico porque tiene que
    arrancar en hardware desconocido; es el instalador, sobre el
    hardware real, quien activa la optimizacion v3.
    """
    for line in str(cpuinfo_text).splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        if key.strip() == "flags":
            return "avx2" in value.split()
    return False


def render_nimbus_repo_block():
    return (
        "[nimbus]\n"
        "SigLevel = Required DatabaseOptional\n"
        f"Include = /etc/pacman.d/{NIMBUS_MIRRORLIST}\n"
    )


def render_nimbus_mirrorlist():
    return (
        "# Repo Nimbus en el sistema instalado: bootstrap local.\n"
        "# El repo público aún no está alojado (ver /etc/nimbus/repo.conf):\n"
        "# hasta su publicación no hay actualizaciones de paquetes nimbus,\n"
        "# pero `pacman -Syu` sigue funcionando para Arch/CachyOS.\n"
        f"Server = {NIMBUS_REPO_SERVER}\n"
    )


def render_repo_conf():
    """Estado del repo Nimbus que deja el postinstall: sin farsa."""
    return (
        "# /etc/nimbus/repo.conf — estado del repositorio Nimbus.\n"
        "# source=bootstrap-local: DB local creada por el postinstall.\n"
        "# status=pending-public-repo: el repo público aún no está alojado;\n"
        "# hasta su publicación, `pacman -Syu` funciona (Arch/CachyOS) pero\n"
        "# los paquetes nimbus no reciben actualizaciones.\n"
        "source=bootstrap-local\n"
        "status=pending-public-repo\n"
    )


def render_cachyos_repo_block(variant):
    """Bloque de repo CachyOS: ``v3`` (AVX2) o ``generic``."""
    if variant == "v3":
        return (
            "[cachyos-v3]\n"
            "SigLevel = PackageRequired\n"
            "Include = /etc/pacman.d/cachyos-v3-mirrorlist\n"
        )
    return (
        "[cachyos]\n"
        "SigLevel = PackageRequired\n"
        "Include = /etc/pacman.d/cachyos-mirrorlist\n"
    )


def ensure_repo_block(conf_text, header, block):
    """Añade ``block`` a ``conf_text`` si ``header`` aun no esta.

    Devuelve ``(texto, cambiado)``: correrlo dos veces no duplica nada.
    """
    lines = conf_text.splitlines()
    if any(line.strip() == header for line in lines):
        return conf_text, False
    if conf_text and not conf_text.endswith("\n"):
        conf_text += "\n"
    if conf_text and not conf_text.endswith("\n\n"):
        conf_text += "\n"
    return conf_text + block.rstrip("\n") + "\n", True


