def _pacman_conf_path(ctx):
    return str(pathlib.Path(str(ctx.root)) / "etc" / "pacman.conf")


def step_keyring(ctx):
    """Copia el keyring de Nimbus y lo puebla (critico)."""
    name, lang = "keyring", ctx.locale
    try:
        dest_dir = str(pathlib.Path(str(ctx.root)) / "usr" / "share"
                        / "pacman" / "keyrings")
        for filename, data in ctx.ex.keyring_source_files():
            ctx.ex.write_text(
                str(pathlib.Path(dest_dir) / filename), data)
        result = ctx.ex.run(["pacman-key", "--populate", "nimbus"])
        if getattr(result, "returncode", 0) != 0:
            raise RuntimeError(
                f"pacman-key --populate nimbus -> "
                f"{getattr(result, 'returncode', '?')}")
        return "ok", translated("postinstall.keyring.done", lang)
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_repo_nimbus(ctx):
    """Añade [nimbus] a pacman.conf sin duplicarlo (critico).

    Apunta al bootstrap local file:// con una DB válida (vacía hasta que
    se publique el repo público): sin `Server` activo `pacman -Syu`
    fallaría, y con un dominio inexistente también. El estado honesto
    queda en /etc/nimbus/repo.conf.
    """
    name, lang = "repo-nimbus", ctx.locale
    try:
        conf_path = _pacman_conf_path(ctx)
        current = ctx.ex.read_text(conf_path, default="")
        block = render_nimbus_repo_block()
        new_text, changed = ensure_repo_block(current, "[nimbus]", block)
        if changed:
            ctx.ex.write_text(conf_path, new_text)
            mirror = str(pathlib.Path(str(ctx.root)) / "etc" / "pacman.d"
                         / NIMBUS_MIRRORLIST)
            ctx.ex.write_text(mirror, render_nimbus_mirrorlist())
            detail = translated("postinstall.repo.added", lang).format(
                header="[nimbus]")
        else:
            detail = translated("postinstall.repo.present", lang).format(
                header="[nimbus]")
        _ensure_local_repo_db(ctx)
        repo_conf = str(pathlib.Path(str(ctx.root)) / NIMBUS_REPO_CONF)
        ctx.ex.write_text(repo_conf, render_repo_conf())
        detail += " " + translated("postinstall.repo.bootstrap", lang)
        return "ok", detail
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def _ensure_local_repo_db(ctx):
    """Garantiza una DB válida en el bootstrap local del destino.

    `tar` viene en la base de Arch; una DB vacía sincroniza bien
    (`pacman -Sy` rc=0 verificado) y no finge paquetes que no hay.
    """
    repo_dir = str(pathlib.Path(str(ctx.root), *NIMBUS_REPO_DIR.split("/")))
    db_tar = str(pathlib.Path(repo_dir) / NIMBUS_REPO_DB)
    try:
        ctx.ex.read_text(db_tar)
        return
    except Exception:
        pass  # no hay DB: se crea una vacía y válida
    mkdir = ctx.ex.run(["mkdir", "-p", repo_dir])
    if getattr(mkdir, "returncode", 0) != 0:
        raise RuntimeError(f"mkdir -p {repo_dir} falló")
    tar = ctx.ex.run(["tar", "-czf", db_tar, "--files-from", "/dev/null"])
    if getattr(tar, "returncode", 0) != 0:
        raise RuntimeError(f"tar -czf {db_tar} falló")
    link = ctx.ex.run(["ln", "-sf", NIMBUS_REPO_DB,
                       str(pathlib.Path(repo_dir) / "nimbus.db")])
    if getattr(link, "returncode", 0) != 0:
        raise RuntimeError("ln -sf nimbus.db falló")


def step_repo_cachyos(ctx):
    """Elige [cachyos-v3] con AVX2 o [cachyos] sin ella (critico)."""
    name, lang = "repo-cachyos", ctx.locale
    try:
        if cpu_supports_avx2(ctx.ex.cpuinfo_text()):
            variant, header = "v3", "[cachyos-v3]"
            note = translated("postinstall.cachyos.v3", lang)
        else:
            variant, header = "generic", "[cachyos]"
            note = translated("postinstall.cachyos.generic", lang)
        conf_path = _pacman_conf_path(ctx)
        current = ctx.ex.read_text(conf_path, default="")
        new_text, changed = ensure_repo_block(
            current, header, render_cachyos_repo_block(variant))
        if changed:
            ctx.ex.write_text(conf_path, new_text)
        return "ok", note
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_refresh_keys(ctx):
    """Recupera la confianza ultimate (critico, necesita red)."""
    name, lang = "refresh-keys", ctx.locale
    try:
        result = ctx.ex.run(["pacman-key", "--refresh-keys"])
        if getattr(result, "returncode", 0) != 0:
            raise RuntimeError(
                f"pacman-key --refresh-keys -> "
                f"{getattr(result, 'returncode', '?')}")
        return "ok", translated("postinstall.refresh.done", lang)
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_services(ctx):
    """Activa snapshots y actualizaciones automaticas (opcional)."""
    name, lang = "services", ctx.locale
    try:
        for service in (SNAPSHOT_TIMER, AUTOUPDATE_TIMER):
            result = ctx.ex.enable_service(service)
            if getattr(result, "returncode", 0) != 0:
                raise RuntimeError(
                    f"enable {service} -> "
                    f"{getattr(result, 'returncode', '?')}")
        return "ok", translated("postinstall.services.done", lang)
    except Exception as exc:
        return "failed", _failed(name, exc, lang)


def step_greeter(ctx):
    """Configura el greeter con el tema Nimbus (opcional)."""
    name, lang = "greeter", ctx.locale
    try:
        path = str(pathlib.Path(str(ctx.root)) / "etc" / "sddm.conf.d"
                    / "nimbus.conf")
