_STEP_FUNCS = {
    "keyring": step_keyring,
    "repo-nimbus": step_repo_nimbus,
    "repo-cachyos": step_repo_cachyos,
    "refresh-keys": step_refresh_keys,
    "services": step_services,
    "greeter": step_greeter,
    "power": step_power,
    "hybrid": step_hybrid,
    "skel": step_skel,
    "os-release": step_os_release,
}


def run_all(ctx, steps=None):
    """Ejecuta los pasos en orden y devuelve (resultados, exit_code).

    Cada resultado es ``{"name", "status", "message"}`` serializable.
    Un paso opcional que falla no aborta; uno critico aborta y lo no
    ejecutado queda como ``skipped``. En ``--offline`` lo que necesita
    red queda como ``skipped``, nunca como ``failed``.
    """
    order = list(steps) if steps is not None else list(STEP_ORDER)
    results = []
    failed_critical = False
    for index, name in enumerate(order):
        if failed_critical:
            results.append({
                "name": name,
                "status": "skipped",
                "message": translated(
                    "postinstall.abort.skipped", ctx.locale),
            })
            continue
        if ctx.offline and name in NETWORK_STEPS:
            results.append({
                "name": name,
                "status": "skipped",
                "message": translated(
                    "postinstall.offline.skipped", ctx.locale),
            })
            continue
        try:
            status, message = _STEP_FUNCS[name](ctx)
        except Exception as exc:  # cinturon y tirantes
            status = "failed"
            message = _failed(name, exc, ctx.locale)
        if status not in ("ok", "skipped", "failed"):
            status = "failed"
            message = _failed(name, message, ctx.locale)
        results.append({"name": name, "status": status,
                        "message": str(message)})
        if status == "failed" and name in CRITICAL_STEPS:
            failed_critical = True
    return results, (1 if failed_critical else 0)


def build_parser():
    parser = argparse.ArgumentParser(
        description=translated(
            "postinstall.cli.description", active_locale()))
    parser.add_argument("--root", required=True, help=translated(
        "postinstall.cli.root", active_locale()))
    parser.add_argument("--offline", action="store_true", help=translated(
        "postinstall.cli.offline", active_locale()))
    parser.add_argument("--locale", default=None, help=translated(
        "postinstall.cli.locale", active_locale()))
    parser.add_argument("--json", action="store_true", help=translated(
        "postinstall.cli.json", active_locale()))
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    locale = args.locale if args.locale else active_locale()
    ctx = Ctx(root=args.root, offline=args.offline, locale=locale)
    results, code = run_all(ctx)
    if args.json:
        print(json.dumps(results, ensure_ascii=False))
    else:
        for item in results:
            print(f"{item['name']}: {item['status']}: {item['message']}")
    return code


if __name__ == "__main__":
    raise SystemExit(main())
