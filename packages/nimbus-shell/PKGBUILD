# SPDX-License-Identifier: GPL-3.0-or-later
pkgname=nimbus-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Shell de escritorio Nimbus para Hyprland (Quickshell/QML)"
arch=('any')
license=('GPL-3.0-or-later')
depends=('quickshell>=0.3.2' 'hyprland>=0.56.2' 'qt6-declarative' 'qt6-wayland' 'qt6-shadertools' 'inter-font')
# Monorepo: el paquete se compila desde el árbol local, sin clonar de GitHub.
# Cuando el repo se divida por subsistema, esto pasa a
# source=('shell::git+https://github.com/juanpimg/NimbusOS.git').
source=()
sha256sums=()
package() {
  install -d "$pkgdir/usr/lib/nimbus/shell"
  cp -r "$startdir/../../shell/src" "$pkgdir/usr/lib/nimbus/shell/src"
  install -Dm755 "$startdir/../../shell/nimbus-shell" "$pkgdir/usr/bin/nimbus-shell"
  # Greeter SDDM de Nimbus: QML funcional propio (dots/sddm/nimbus) con el
  # arte original del proyecto (SVG de installer/greeter, solo lectura: esa
  # pista es duena de esos ficheros). Nada de assets de terceros.
  install -Dm644 "$startdir/../../dots/sddm/nimbus/Main.qml" "$pkgdir/usr/share/sddm/themes/nimbus/Main.qml"
  install -Dm644 "$startdir/../../dots/sddm/nimbus/metadata.desktop" "$pkgdir/usr/share/sddm/themes/nimbus/metadata.desktop"
  install -Dm644 "$startdir/../../dots/sddm/nimbus/theme.conf" "$pkgdir/usr/share/sddm/themes/nimbus/theme.conf"
  install -Dm644 "$startdir/../../installer/greeter/nimbus-greeter/background.svg" "$pkgdir/usr/share/sddm/themes/nimbus/background.svg"
  install -Dm644 "$startdir/../../installer/greeter/nimbus-greeter/logo.svg" "$pkgdir/usr/share/sddm/themes/nimbus/logo.svg"
  install -Dm644 "$startdir/../../installer/greeter/nimbus-greeter/avatar-placeholder.svg" "$pkgdir/usr/share/sddm/themes/nimbus/avatar-placeholder.svg"
}
